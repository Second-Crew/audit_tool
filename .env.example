GOOGLE_PAGESPEED_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AUDIT_LLM_PROVIDER=gemini
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL of the deployed app; used to build tracked report links (/r/<id>).
NEXT_PUBLIC_APP_URL=
# Set to enable the team login gate. When set, the whole workspace requires
# this password; prospect report links (/r/<id>) stay public. Leave empty to
# disable (e.g. local development).
APP_ACCESS_PASSWORD=

# Server-only TypeSafe pilot. With a key, runs automatically on Preview/local;
# production stays off unless explicitly set to shadow. Never use NEXT_PUBLIC_.
TYPESAFE_API_KEY=
# Optional kill switch: off | shadow. Leave unset for the environment default.
# TYPESAFE_AUDIT_MODE=off

# Agent API: disabled until the SQL migration and persistent worker are configured.
AGENT_API_ENABLED=false
# JSON array: [{"id":"workflow-1","tenantId":"secondcrew","sha256":"<SHA-256 of a random bearer token>","scopes":["audits:create","audits:read","audits:cancel"]}]
AGENT_API_KEYS_JSON=[]
# Leave empty until a check/profile has held-out benchmark approval.
# [{"checkId":"html.title","methodologyVersion":"evidence-1.0","profile":"ecommerce","benchmarkId":"<reviewed benchmark ID>"}]
AGENT_VALIDATED_CHECKS_JSON=[]
