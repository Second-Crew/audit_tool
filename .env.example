GOOGLE_PAGESPEED_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AUDIT_LLM_PROVIDER=gemini
# Experimental free-form narrative is off until its claims are validated.
AUDIT_GENERATED_NARRATIVE_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL of the deployed app; used to build tracked report links (/r/<id>).
NEXT_PUBLIC_APP_URL=
# Set to enable the team login gate. When set, the whole workspace requires
# this password; prospect report links (/r/<id>) stay public. Leave empty to
# disable (e.g. local development).
APP_ACCESS_PASSWORD=

# Server-only TypeSafe key for Preview claim evaluation. Never use NEXT_PUBLIC_.
# Generic content scoring is off by default in every environment.
TYPESAFE_API_KEY=
# Optional legacy diagnostic pilot: shadow explicitly opts in; off is default.
# TYPESAFE_AUDIT_MODE=off

# Agent API: disabled until the SQL migration and persistent worker are configured.
AGENT_API_ENABLED=false
# JSON array: [{"id":"workflow-1","tenantId":"secondcrew","sha256":"<SHA-256 of a random bearer token>","scopes":["audits:create","audits:read","audits:cancel"]}]
AGENT_API_KEYS_JSON=[]
# Leave empty until a check/profile has held-out benchmark approval.
# [{"checkId":"html.title","methodologyVersion":"evidence-1.0","profile":"ecommerce","benchmarkId":"<reviewed benchmark ID>"}]
AGENT_VALIDATED_CHECKS_JSON=[]

# Optional JavaScript rendering for sparse pages (server-side only). Configure one.
# Use a trusted Playwright-native browser endpoint; keep the full URL secret.
RENDER_BROWSER_WS_ENDPOINT=
# Local/worker alternative, e.g. /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
RENDER_CHROME_EXECUTABLE_PATH=
