GOOGLE_PAGESPEED_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AUDIT_LLM_PROVIDER=gemini
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL of the deployed app; used to build tracked report links (/r/<id>).
NEXT_PUBLIC_APP_URL=
# Set to enable the team login gate. When set, the whole workspace requires
# this password; prospect report links (/r/<id>) stay public. Leave empty to
# disable (e.g. local development).
APP_ACCESS_PASSWORD=

# Server-only TypeSafe pilot. With a key, runs automatically on Preview/local;
# production stays off unless explicitly set to shadow. Never use NEXT_PUBLIC_.
TYPESAFE_API_KEY=
# Optional kill switch: off | shadow. Leave unset for the environment default.
# TYPESAFE_AUDIT_MODE=off
